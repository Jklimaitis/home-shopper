# =============================================================================
# DADOS SENSIVEIS -- NAO COMMITAR
#
# A chave de acesso da NFC-e e a porta de entrada para os dados do
# consumidor. Quem tiver a chave consegue puxar a nota na SEFAZ, inclusive
# CPF e historico de compras. Dado de terceiro, protected pela LGPD.
#
# O repositorio e PRIVADO. Fixtures devem usar apenas dados sinteticos.
# Estas regras nao removem dados ja versionados nem substituem a auditoria
# de privacidade antes de qualquer publicacao.
# =============================================================================

# Segredos e ambiente
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dados reais de compra -- NUNCA versionados
*.nfce
*.nfe
*.xml
cupons/
notas/
dados_reais/
fixtures/reais/
*.cpf
*.chave
private/
raw/

# Capturas de cupom (contem CPF, endereco, itens comprados)
uploads/
cupom*.jpg
cupom*.png
cupom*.jpeg
cupom*.webp
storage/
media/

# Banco local
*.sqlite
*.sqlite3
*.db
pgdata/
dump*.sql
backup*.sql

# Backups e exportações locais
backups/
dumps/
receipt-imports/
*.dump
*.backup
*.sql.gz
*.sql.bz2
*.sql.xz

# Build e cobertura
build/
dist/
htmlcov/
.coverage
.coverage.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Arquivos de depuracao temporarios
_pr*.sql
_iso*.sql
_*.sql

# Worktrees por card -- nunca versionar
.worktrees/
