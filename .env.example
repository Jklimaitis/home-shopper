# =============================================================================
# Copie para .env e preencha. O .env NUNCA e versionado (veja .gitignore).
#   python3 scripts/prepare_env.py    # cria/confere o .env do worktree
#   (ou, a mao: cp .env.example .env)
# =============================================================================

# --- Banco de dados -------------------------------------------------------
# usuario: criado no container, nao use postgres/admin
DB_HOST=localhost
DB_PORT=5432
DB_NAME=home_shopper
DB_USER=home_shopper
# Gere uma senha real: openssl rand -base64 32
DB_PASSWORD=

# --- Credenciais de terceiros (fora do git, sempre) ------------------------
# Chave CSC do emitente, usada para validar o QR Code da NFC-e.
# NUNCA hardcode no codigo: cada loja tem a sua.
SEFAZ_CSC_POR_LOJA=
# Exemplo (CNPJ ficticio, apenas ilustrativo):
# {"00000000000000": "CSC_DA_LOJA_AQUI"}

# --- Autenticacao da API ---------------------------------------------------
# Configure estes segredos somente no .env privado, nunca neste modelo.
# JWT_SECRET_KEY: chave de assinatura dos tokens da API, minimo 32 bytes.
JWT_SECRET_KEY=
# AUTH_PEPPER: segredo adicional usado pelo backend de senhas.
AUTH_PEPPER=
# UUIDs de administradores do catalogo, separados por virgula.
# Vazio: nenhuma escrita direta no catalogo e autorizada.
CATALOG_ADMIN_USER_IDS=
# Campo legado preservado para compatibilidade com o preparador de ambiente.
# A API atual usa JWT_SECRET_KEY, nao SECRET_KEY.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Processamento assincrono (Fase 2) --------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Armazenamento de cupons (fora do banco; ver ADR-004) -------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# --- Observabilidade -------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
